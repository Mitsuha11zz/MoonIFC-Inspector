ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('MoonIFC spatial hierarchy example'),'2;1');
ENDSEC;
DATA;
#1=IFCPROJECT('PROJECT-1');
#2=IFCSITE('SITE-1');
#3=IFCBUILDING('BUILDING-1');
#4=IFCBUILDINGSTOREY('LEVEL-1');
#5=IFCSPACE('ROOM-1');
#6=IFCWALL('WALL-1');
#7=IFCDOOR('DOOR-1');
#8=IFCBUILDINGSTOREY('LEVEL-2');
#9=IFCWINDOW('WINDOW-1');
#10=IFCRELAGGREGATES('REL-1',$,$,$,#1,(#2));
#11=IFCRELAGGREGATES('REL-2',$,$,$,#2,(#3));
#12=IFCRELAGGREGATES('REL-3',$,$,$,#3,(#4,#8));
#13=IFCRELAGGREGATES('REL-4',$,$,$,#4,(#5));
#14=IFCRELCONTAINEDINSPATIALSTRUCTURE('REL-5',$,$,$,(#6,#7),#5);
#15=IFCRELCONTAINEDINSPATIALSTRUCTURE('REL-6',$,$,$,(#9),#8);
ENDSEC;
END-ISO-10303-21;
